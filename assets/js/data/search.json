---
layout: null
swcache: true
---
{% assign searchable_posts = site.posts | where_exp: 'post', 'post.hidden != true' %}
[
{% for post in searchable_posts %}
{
  "title": {{ post.title | jsonify }},
  "url": {{ post.url | relative_url | jsonify }},
  "categories": {{ post.bori_kind_label | jsonify }},
  "tags": {{ post.bori_tags | join: ', ' | jsonify }},
  "date": {{ post.date | jsonify }},
  "content": {{ post.bori_text | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
