--- previous/assets/css/reader-visuals.scss
+++ round-09/assets/css/reader-visuals.scss
@@ -66,6 +66,20 @@
 .reader-visuals .rv-gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 1.2rem; }
 .reader-visuals .rv-gallery-count-1 { max-width: 34rem; }
 .reader-visuals .rv-gallery .rv-caption { color: var(--rv-ink); margin-bottom: .3rem; font-size: .95rem; }
+.reader-visuals .rv-preview-label { display: block; font-size: .75rem; line-height: 1.65; color: var(--rv-muted); margin-bottom: .4rem; }
+.reader-visuals.rv-paper .rv-has-image { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 1.1rem; }
+.reader-visuals.rv-essay { border-inline-start: 4px solid var(--rv-accent); border-radius: .3rem .9rem .9rem .3rem; }
+.reader-visuals.rv-essay .rv-sources { margin-top: 1.4rem; }
+.reader-visuals.rv-essay .rv-source { border: 0; border-top: 1px solid var(--rv-line); border-radius: 0; padding: 1rem 0 0; background: transparent; }
+.reader-visuals.rv-essay .rv-source-image { max-width: 24rem; }
+.reader-visuals.rv-journal { border-radius: .25rem; border-inline-start: 0; border-inline-end: 0; }
+.reader-visuals.rv-journal .rv-sources { margin-top: 1.5rem; gap: .6rem; }
+.reader-visuals.rv-journal .rv-source { border-width: 0 0 1px; border-radius: 0; padding: .8rem 0; background: transparent; }
+.reader-visuals.rv-journal .rv-has-image { display: grid; grid-template-columns: minmax(0, 10rem) minmax(0, 1fr); gap: 1rem; }
+.reader-visuals.rv-journal .rv-diagram:first-of-type, .reader-visuals.rv-essay .rv-diagram:first-of-type { border-top: 0; padding-top: 0; }
+@media (max-width: 600px) {
+  .reader-visuals.rv-paper .rv-has-image, .reader-visuals.rv-journal .rv-has-image { grid-template-columns: minmax(0, 1fr); }
+}
 .reader-visuals .rv-node-list { margin: .5rem 0; padding-inline-start: 1.4rem; }
 .reader-visuals .rv-node-list li { padding: .3rem 0 .7rem; }
 .reader-visuals .rv-node-list p { font-size: .9rem; margin: .4rem 0 0; line-height: 1.7; }
