--- previous/_plugins/reader-visuals.rb
+++ round-01/_plugins/reader-visuals.rb
@@ -0,0 +1,49 @@
+# frozen_string_literal: true
+
+require "cgi"
+require_relative "reader-visuals-schema"
+
+module BoriVisuals
+  module_function
+
+  def escape(value)
+    CGI.escapeHTML(value.to_s)
+  end
+
+  def href(value, baseurl)
+    escape(value.start_with?("/") ? "#{baseurl.to_s.sub(%r{/\z}, '')}#{value}" : value)
+  end
+
+  def source_card(source, baseurl)
+    host = URI.parse(source["url"]).host || "This site / 이 블로그"
+    <<~HTML
+      <article class="rv-source" id="rv-source-#{escape(source['id'])}">
+        <div class="rv-source-body">
+          <span class="rv-host">#{escape(host)}</span>
+          <h3><a href="#{href(source['url'], baseurl)}">#{escape(source['title'])}</a></h3>
+          #{source['description'] ? "<p>#{escape(source['description'])}</p>" : ""}
+        </div>
+      </article>
+    HTML
+  end
+
+  def render(data, root:, baseurl: "")
+    validate(data, root: root)
+    <<~HTML
+      <section class="reader-visuals rv-#{escape(data.fetch('style', 'essay'))}" aria-label="Sources and article maps / 출처와 글 지도" data-visuals-version="1">
+        <header class="rv-heading"><p class="rv-kicker">Reading companion / 함께 읽기</p><h2>Sources &amp; maps / 출처와 지도</h2></header>
+        <div class="rv-sources">#{data['sources'].map { |source| source_card(source, baseurl) }.join}</div>
+      </section>
+    HTML
+  end
+end
+
+Jekyll::Hooks.register :posts, :post_render do |post|
+  next unless post.data.key?("reader_visuals")
+  html = BoriVisuals.render(post.data["reader_visuals"], root: post.site.source, baseurl: post.site.baseurl)
+  marker = /(<div\b[^>]*class=["']content["'][^>]*>)/
+  raise BoriVisuals::Invalid, "#{post.relative_path}: article content container is missing" unless post.output.match?(marker)
+  post.output = post.output.sub(marker) { "#{Regexp.last_match(1)}\n#{html}" }
+rescue BoriVisuals::Invalid => error
+  raise Jekyll::Errors::FatalException, "#{post.relative_path}: #{error.message}"
+end
