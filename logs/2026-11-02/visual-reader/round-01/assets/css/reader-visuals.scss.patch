--- previous/assets/css/reader-visuals.scss
+++ round-01/assets/css/reader-visuals.scss
@@ -0,0 +1,31 @@
+---
+---
+
+.reader-visuals {
+  --rv-ink: #263445;
+  --rv-muted: #526479;
+  --rv-line: #b6c4d2;
+  --rv-panel: #f2f6fa;
+  --rv-accent: #38558f;
+  margin: 1.5rem 0 2.5rem;
+  padding: clamp(1rem, 3vw, 1.6rem);
+  color: var(--rv-ink);
+  border: 1px solid var(--rv-line);
+  border-radius: 1rem;
+  background: var(--rv-panel);
+}
+[data-bs-theme="dark"] .reader-visuals {
+  --rv-ink: #e5ecf4;
+  --rv-muted: #b9c9d9;
+  --rv-line: #55687d;
+  --rv-panel: #202a35;
+  --rv-accent: #b9cfff;
+}
+.reader-visuals .rv-kicker, .reader-visuals .rv-host { color: var(--rv-muted); font-size: .85rem; }
+.reader-visuals .rv-kicker { margin-bottom: .3rem; letter-spacing: .03em; }
+.reader-visuals .rv-heading h2 { margin: 0 0 1.2rem; font-size: 1.35rem; }
+.reader-visuals .rv-sources { display: grid; gap: 1rem; }
+.reader-visuals .rv-source { padding: 1rem; border: 1px solid var(--rv-line); border-radius: .6rem; background: var(--main-bg); }
+.reader-visuals .rv-source h3 { margin: .4rem 0; font-size: 1.1rem; line-height: 1.5; }
+.reader-visuals .rv-source p { margin: .5rem 0 0; line-height: 1.7; }
+.reader-visuals a { color: var(--rv-accent) !important; }
