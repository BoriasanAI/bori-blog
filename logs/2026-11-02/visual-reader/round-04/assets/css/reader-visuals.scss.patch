--- previous/assets/css/reader-visuals.scss
+++ round-04/assets/css/reader-visuals.scss
@@ -38,3 +38,18 @@
 .reader-visuals .rv-credit, .reader-visuals .rv-caption { display: block; font-size: .8rem; line-height: 1.65; color: var(--rv-muted); }
 .reader-visuals .rv-image figcaption { margin-top: .5rem; text-align: start; font-style: normal; }
 .reader-visuals .rv-no-image { margin: 0 0 .6rem; font-size: .75rem; color: var(--rv-muted); }
+.reader-visuals .rv-diagram { margin: 1.5rem 0 0; padding-top: 1.25rem; border-top: 1px solid var(--rv-line); }
+.reader-visuals .rv-diagram figcaption { text-align: start; font-style: normal; }
+.reader-visuals .rv-diagram h3 { margin: 0 0 .4rem; font-size: 1.15rem; }
+.reader-visuals .rv-diagram figcaption > p { font-size: .85rem; color: var(--rv-muted); }
+.reader-visuals .rv-outline-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 1rem; }
+.reader-visuals .rv-diagram svg { display: block; width: 100%; max-height: none; overflow: visible; }
+.reader-visuals .rv-diagram svg rect { fill: var(--main-bg); stroke: var(--rv-line); }
+.reader-visuals .rv-diagram svg circle { fill: var(--rv-accent); }
+.reader-visuals .rv-svg-label { fill: var(--rv-ink); font-size: 16px; }
+.reader-visuals .rv-node-list { margin: .5rem 0; padding-inline-start: 1.4rem; }
+.reader-visuals .rv-node-list li { padding: .3rem 0 .7rem; }
+.reader-visuals .rv-node-list p { font-size: .9rem; margin: .4rem 0 0; line-height: 1.7; }
+@media (max-width: 600px) {
+  .reader-visuals .rv-outline-layout { grid-template-columns: minmax(0, 1fr); }
+}
