--- previous/_plugins/reader-visuals-images.rb
+++ round-03/_plugins/reader-visuals-images.rb
@@ -0,0 +1,65 @@
+# frozen_string_literal: true
+
+require "nokogiri"
+
+module BoriVisuals
+  module_function
+
+  def local_image(image, root, at)
+    object(image, %w[path alt caption credit license url], at)
+    %w[path alt credit license].each { |key| text(image[key], "#{at}.#{key}", 500) }
+    text(image["caption"], "#{at}.caption") if image.key?("caption")
+    url(image["url"], "#{at}.url") if image.key?("url")
+    path = image["path"]
+    raise Invalid, "#{at}.path: expected a local /assets/ image path" unless path.start_with?("/assets/") &&
+      !path.match?(/[%\\?#]/) && !path.split("/").include?("..")
+    file = File.join(root, path.delete_prefix("/"))
+    raise Invalid, "#{at}.path: missing local image #{path}" unless File.file?(file)
+    raise Invalid, "#{at}.path: image escapes source assets" unless File.realpath(file).start_with?("#{File.realpath(root)}/assets/")
+    raise Invalid, "#{at}.path: image exceeds 10 MiB" if File.size(file) > 10 * 1024 * 1024
+    dimensions = image_dimensions(file)
+    raise Invalid, "#{at}.path: unsupported image or missing intrinsic dimensions" unless dimensions &&
+      dimensions.all? { |value| value.is_a?(Integer) && value.positive? && value <= 50_000 }
+    dimensions
+  end
+
+  def image_dimensions(file)
+    bytes = File.binread(file)
+    return bytes[16, 8]&.unpack("NN") if bytes.start_with?("\x89PNG\r\n\x1a\n".b)
+    return bytes[6, 4]&.unpack("vv") if bytes.start_with?("GIF87a", "GIF89a")
+    if bytes.start_with?("RIFF") && bytes[8, 4] == "WEBP"
+      type = bytes[12, 4]
+      return [1 + bytes[24, 3].unpack1("H*").scan(/../).reverse.join.to_i(16),
+              1 + bytes[27, 3].unpack1("H*").scan(/../).reverse.join.to_i(16)] if type == "VP8X"
+      return bytes[26, 4]&.unpack("vv")&.map { |value| value & 0x3fff } if type == "VP8 "
+      if type == "VP8L" && bytes.bytesize >= 25
+        packed = bytes[21, 4].unpack1("V")
+        return [(packed & 0x3fff) + 1, ((packed >> 14) & 0x3fff) + 1]
+      end
+    end
+    if bytes.start_with?("\xff\xd8".b)
+      offset = 2
+      while offset + 8 < bytes.bytesize
+        break unless bytes.getbyte(offset) == 0xff
+        marker = bytes.getbyte(offset + 1)
+        length = bytes[offset + 2, 2].unpack1("n")
+        return bytes[offset + 5, 4].unpack("nn").reverse if [0xc0, 0xc1, 0xc2].include?(marker)
+        break if length < 2
+        offset += length + 2
+      end
+    end
+    return unless File.extname(file).downcase == ".svg"
+    svg = Nokogiri::XML(bytes) { |config| config.strict.nonet }
+    return unless svg.root&.name == "svg" && svg.internal_subset.nil?
+    return if svg.xpath("//*[local-name()='script' or local-name()='foreignObject']").any?
+    return if svg.xpath("//@*").any? { |attribute| attribute.name.start_with?("on") ||
+      (attribute.name == "href" && !attribute.value.start_with?("#")) || attribute.value.match?(/url\s*\(\s*[^#]|@import/i) }
+    return if svg.css("style").any? { |style| style.text.match?(/url\s*\(|@import/i) }
+    width, height = %w[width height].map { |key| svg.root[key].to_s.delete_suffix("px") }
+    return [width.to_i, height.to_i] if [width, height].all? { |value| value.match?(/\A\d+\z/) }
+    box = svg.root["viewBox"].to_s.split.map { |value| Float(value, exception: false) }
+    box[2, 2]&.map(&:to_i) if box.size == 4 && box.all?
+  rescue Nokogiri::XML::SyntaxError, ArgumentError
+    nil
+  end
+end
