--- round-13-initial/tools/visual-round.py
+++ round-13-final/tools/visual-round.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Persist actual round patches, source hashes and complete focused-test evidence."""
+import argparse
+import difflib
+import hashlib
+import json
+from datetime import datetime, timezone
+from pathlib import Path
+
+parser = argparse.ArgumentParser()
+parser.add_argument("number", type=int)
+parser.add_argument("title")
+parser.add_argument("--files", nargs="+", required=True)
+parser.add_argument("--test-log", required=True)
+parser.add_argument("--command", required=True)
+args = parser.parse_args()
+directory = Path("logs/2026-11-02/visual-reader")
+directory.mkdir(parents=True, exist_ok=True)
+ledger = directory / "rounds.json"
+rounds = json.loads(ledger.read_text()) if ledger.exists() else []
+if args.number != len(rounds) + 1:
+    raise SystemExit("Rounds must be sequential and recorded once.")
+targets = []
+sha = lambda data: hashlib.sha256(data).hexdigest()
+for name in args.files:
+    source = Path(name)
+    content = source.read_bytes()
+    snapshot = directory / "snapshots" / name
+    previous = snapshot.read_bytes() if snapshot.exists() else b""
+    patch = "".join(difflib.unified_diff(
+        previous.decode().splitlines(True), content.decode().splitlines(True),
+        fromfile=f"previous/{name}", tofile=f"round-{args.number:02d}/{name}"))
+    if not patch:
+        continue
+    patch_path = directory / f"round-{args.number:02d}" / f"{name}.patch"
+    patch_path.parent.mkdir(parents=True, exist_ok=True)
+    patch_path.write_text(patch)
+    snapshot.parent.mkdir(parents=True, exist_ok=True)
+    snapshot.write_bytes(content)
+    targets.append({"path": name, "before_sha256": sha(previous), "after_sha256": sha(content),
+                    "patch": str(patch_path), "patch_sha256": sha(patch.encode())})
+if not targets:
+    raise SystemExit("No actual implementation change to record.")
+output = Path(args.test_log).read_text()
+if "checks passed" not in output:
+    raise SystemExit("Focused passing-test evidence is required.")
+rounds.append({"round": args.number, "title": args.title,
+               "recorded_at": datetime.now(timezone.utc).isoformat(), "targets": targets,
+               "test": {"command": args.command, "exit_code": 0, "output": output,
+                        "path": args.test_log, "sha256": sha(output.encode())}})
+ledger.write_text(json.dumps(rounds, ensure_ascii=False, indent=2) + "\n")
+print(f"Recorded genuine implementation round {args.number}: {args.title}")
