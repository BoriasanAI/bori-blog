--- previous/assets/css/reader-visuals.scss
+++ round-10/assets/css/reader-visuals.scss
@@ -80,6 +80,20 @@
 @media (max-width: 600px) {
   .reader-visuals.rv-paper .rv-has-image, .reader-visuals.rv-journal .rv-has-image { grid-template-columns: minmax(0, 1fr); }
 }
+.reader-visuals a { display: inline-flex; align-items: center; min-height: 44px; max-width: 100%; }
+.reader-visuals a:focus-visible, .reader-visuals [tabindex]:focus-visible { outline: 3px solid var(--rv-accent); outline-offset: 3px; border-radius: .2rem; }
+.reader-visuals .rv-node-list a, .reader-visuals .rv-timeline a { text-decoration: underline; text-underline-offset: .2em; }
+@media (prefers-reduced-motion: reduce) {
+  .reader-visuals, .reader-visuals * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
+}
+@media print {
+  .reader-visuals { --rv-ink: #111; --rv-muted: #333; --rv-line: #888; --rv-panel: #fff; --rv-accent: #111; color: #111; background: #fff; padding: 1rem; }
+  .reader-visuals .rv-outline svg, .reader-visuals .rv-evidence-map svg { display: none; }
+  .reader-visuals .rv-outline-layout { display: block; }
+  .reader-visuals .rv-source, .reader-visuals .rv-node-list li, .reader-visuals .rv-timeline li { break-inside: avoid; }
+  .reader-visuals a { min-height: 0; color: #111 !important; text-decoration: underline; }
+  .reader-visuals .rv-image img { max-height: 12rem; object-fit: contain; }
+}
 .reader-visuals .rv-node-list { margin: .5rem 0; padding-inline-start: 1.4rem; }
 .reader-visuals .rv-node-list li { padding: .3rem 0 .7rem; }
 .reader-visuals .rv-node-list p { font-size: .9rem; margin: .4rem 0 0; line-height: 1.7; }
