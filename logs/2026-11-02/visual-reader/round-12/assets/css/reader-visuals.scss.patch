--- previous/assets/css/reader-visuals.scss
+++ round-12/assets/css/reader-visuals.scss
@@ -84,6 +84,8 @@
 .reader-visuals, .reader-visuals * { box-sizing: border-box; }
 .reader-visuals, .reader-visuals .rv-source, .reader-visuals .rv-source-body, .reader-visuals .rv-outline-layout > * { min-width: 0; overflow-wrap: anywhere; }
 .reader-visuals .rv-image img { max-width: 100%; object-fit: contain; }
+.reader-visuals .rv-image img[hidden] { display: none; }
+.reader-visuals .rv-image-error { padding: .8rem; border: 1px dashed var(--rv-line); border-radius: .4rem; font-size: .9rem; line-height: 1.7; color: var(--rv-ink); }
 .reader-visuals .rv-credit, .reader-visuals .rv-preview-label, .reader-visuals .rv-image figcaption { font-size: .875rem; }
 .reader-visuals .rv-table-scroll { max-width: 100%; min-width: 0; }
 .reader-visuals .rv-comparison table { min-width: 25rem; }
