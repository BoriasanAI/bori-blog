--- previous/assets/css/reader-visuals.scss
+++ round-07/assets/css/reader-visuals.scss
@@ -55,6 +55,12 @@
 .reader-visuals .rv-timeline li::before { content: ""; position: absolute; inset-inline-start: -.38rem; top: .4rem; width: .65rem; height: .65rem; border-radius: 50%; background: var(--rv-accent); }
 .reader-visuals .rv-timeline time { display: block; font-size: .85rem; font-weight: 650; color: var(--rv-muted); font-variant-numeric: tabular-nums; }
 .reader-visuals .rv-timeline li > div { margin-top: .35rem; line-height: 1.65; }
+.reader-visuals .rv-table-scroll { overflow-x: auto; overscroll-behavior-inline: contain; margin-top: .8rem; }
+.reader-visuals .rv-comparison table { width: 100%; margin: 0; border-collapse: collapse; }
+.reader-visuals .rv-comparison caption { caption-side: top; padding: 0 0 .7rem; font-size: .85rem; color: var(--rv-muted); }
+.reader-visuals .rv-comparison th, .reader-visuals .rv-comparison td { padding: .8rem; vertical-align: top; border: 1px solid var(--rv-line); text-align: start; line-height: 1.7; }
+.reader-visuals .rv-comparison thead th { background: var(--main-bg); font-size: .85rem; }
+.reader-visuals .rv-comparison tbody th { width: 32%; font-size: .9rem; }
 .reader-visuals .rv-node-list { margin: .5rem 0; padding-inline-start: 1.4rem; }
 .reader-visuals .rv-node-list li { padding: .3rem 0 .7rem; }
 .reader-visuals .rv-node-list p { font-size: .9rem; margin: .4rem 0 0; line-height: 1.7; }
